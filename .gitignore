# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eval results (local-only; see eval/README.md)
eval/results-*.json

# dev-only demo session cookie and screenshots (pnpm seed:demo, pnpm shot)
/.superpowers/
.superpowers/demo-cookie.txt

# UI audit screenshots (pnpm ui:audit); only the README is committed
/docs/design/qa/*.png
