CREDIT_TOMBSTONE_PEPPER=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OFF_CONTACT_EMAIL=
GOOGLE_GENERATIVE_AI_API_KEY=
MODEL_FAST=
MODEL_STRONG=
