# Optional: scan image storage on Cloudflare R2. All four must be set, or storage stays off.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: the public address (share images, canonical links, sitemap). Defaults to the Vercel production URL, then localhost.
NEXT_PUBLIC_SITE_URL=
